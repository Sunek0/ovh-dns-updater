{
  "name": "ovh-dns-updater-ng",
  "version": "1.0.0",
  "description": "Dynamic DNS updater for OVH accounts",
  "main": "dist/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.15.0"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.1",
    "config": "5.0.1",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "js-yaml": "5.5.0",
    "ovh": "2.0.3",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
